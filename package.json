{
  "name": "xapp-electron",
  "version": "1.0.0",
  "description": "XApp using the electron framework",
  "main": "main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "yarn@4.18.1",
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@mantine/core": "^9.6.3",
    "@mantine/hooks": "^9.6.3",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "nodemon": "^3.1.14",
    "prettier": "^2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5",
    "vite": "^8.3.2"
  },
  "scripts": {
    "build": "tsc && vite build",
    "start": "yarn build && electron .",
    "dev": "vite build --watch",
    "watch": "nodemon --watch dist --watch main.js --watch preload.js --watch apiClient.js --exec electron .",
    "test": "yarn build && playwright test",
    "format": "prettier --write renderer test",
    "release": "scripts/release.sh release",
    "release:preview": "scripts/release.sh preview",
    "build-win": "yarn build && electron-packager . X-App --overwrite --asar=true --platform=win32 --arch=ia32 --icon=assets/icons/win/icon.ico --prune=true --ignore=^/renderer --ignore=^/test --ignore=^/.github --ignore=^/.idea --ignore=^/.yarn --ignore=^/deploy --out=release-builds --version-string.CompanyName=CE --version-string.FileDescription=CE --version-string.ProductName=\"X-App\"",
    "build-mac": "yarn build && electron-packager . --overwrite --platform=darwin --arch=x64 --icon=assets/icons/mac/icon.icns --prune=true --ignore=^/renderer --ignore=^/test --ignore=^/.github --ignore=^/.idea --ignore=^/.yarn --ignore=^/deploy --out=release-builds --darwinDarkModeSupport=true",
    "build-linux": "yarn build && electron-packager . X-App --overwrite --asar=true --platform=linux --arch=x64 --icon=assets/icons/png/1024x1024.png --prune=true --ignore=^/renderer --ignore=^/test --ignore=^/.github --ignore=^/.idea --ignore=^/.yarn --ignore=^/deploy --out=release-builds"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KSG-IT/XApp-Electron.git"
  },
  "author": "Christian De Frène",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/KSG-IT/XApp-Electron/issues"
  },
  "homepage": "https://github.com/KSG-IT/XApp-Electron#readme",
  "dependencies": {
    "@sentry/electron": "^8.1.0"
  }
}
